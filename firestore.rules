rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Authentication Helpers
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn()
          && request.auth.uid == userId;
    }

    // ============================================================
    // Ownership Helpers
    // ============================================================

    function ownsExistingDocument() {
      return isSignedIn()
          && resource.data.ownerId == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return isSignedIn()
          && request.resource.data.ownerId == request.auth.uid;
    }

    // ============================================================
    // Immutable / Protected Field Helpers
    // ============================================================

    function resumeProtectedFieldsUnchanged() {
      return !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'id',
            'ownerId',
            'createdAt'
          ]);
    }

    function coverLetterProtectedFieldsUnchanged() {
      return !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'id',
            'ownerId',
            'createdAt'
          ]);
    }

    function userProtectedFieldsUnchanged() {
      return !request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasAny([
            'uid',
            'subscriptionPlan',
            'createdAt'
          ]);
    }

    // ============================================================
    // Users
    // ============================================================

    match /users/{userId} {

      allow get: if isSelf(userId);

      // Prevent profile enumeration.
      allow list: if false;

      allow create: if isSelf(userId)
          && request.resource.data.keys().hasAll([
            'uid',
            'subscriptionPlan',
            'onboardingCompleted',
            'createdAt'
          ])
          && request.resource.data.uid == userId
          && request.resource.data.subscriptionPlan == 'free'
          && request.resource.data.onboardingCompleted == false;

      allow update: if isSelf(userId)
          && request.resource.data.uid == userId
          && userProtectedFieldsUnchanged();

      // Account deletion will eventually go through
      // controlled application/backend logic.
      allow delete: if false;

      // ----------------------------------------------------------
      // User Preferences
      // ----------------------------------------------------------

      match /preferences/{preferenceId} {
        allow read, write: if isSelf(userId);
      }

      // ----------------------------------------------------------
      // User Activity
      // ----------------------------------------------------------

      match /activity/{activityId} {
        allow read: if isSelf(userId);

        // Activity logs are server-authoritative.
        allow create, update, delete: if false;
      }
    }

    // ============================================================
    // Resumes
    // ============================================================

    match /resumes/{resumeId} {

      allow read: if ownsExistingDocument();

      allow create: if ownsIncomingDocument()
          && request.resource.data.id == resumeId;

      allow update: if ownsExistingDocument()
          && ownsIncomingDocument()
          && request.resource.data.id == resumeId
          && resumeProtectedFieldsUnchanged();

      allow delete: if ownsExistingDocument();
    }

    // ============================================================
    // Resume Versions
    // ============================================================

    match /resume_versions/{versionId} {

      allow read: if ownsExistingDocument();

      allow create: if ownsIncomingDocument()
          && request.resource.data.id == versionId;

      // Historical resume snapshots must remain immutable.
      allow update: if false;

      allow delete: if ownsExistingDocument();
    }

    // ============================================================
    // ATS Analyses
    // ============================================================

    match /ats_analyses/{analysisId} {

      allow read: if ownsExistingDocument();

      // ATS results must originate from the trusted backend.
      allow create, update: if false;

      allow delete: if ownsExistingDocument();
    }

    // ============================================================
    // Cover Letters
    // ============================================================

    match /cover_letters/{coverLetterId} {

      allow read: if ownsExistingDocument();

      allow create: if ownsIncomingDocument()
          && request.resource.data.id == coverLetterId;

      allow update: if ownsExistingDocument()
          && ownsIncomingDocument()
          && request.resource.data.id == coverLetterId
          && coverLetterProtectedFieldsUnchanged();

      allow delete: if ownsExistingDocument();
    }

    // ============================================================
    // AI Generation Audit
    // ============================================================

    match /ai_generations/{generationId} {

      allow read: if ownsExistingDocument();

      // AI audit records are generated by backend infrastructure.
      allow create, update, delete: if false;
    }

    // ============================================================
    // Subscription / Entitlement State
    // ============================================================

    match /subscriptions/{userId} {

      allow read: if isSelf(userId);

      // Plan, usage limits, billing status and entitlements
      // must never be controlled by the Flutter client.
      allow create, update, delete: if false;
    }

    // ============================================================
    // Default Deny
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}