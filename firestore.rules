rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn()
          && request.auth.uid == uid;
    }

    function ownsExistingDocument() {
      return isSignedIn()
          && resource.data.ownerId
              == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return isSignedIn()
          && request.resource.data.ownerId
              == request.auth.uid;
    }

    function hasCurrentLegalConsent() {
      return request.resource.data
              .acceptedTermsVersion
              == '2026-09-30'
          && request.resource.data
              .acceptedPrivacyVersion
              == '2026-09-30'
          && request.resource.data
              .termsAcceptedAt
              is timestamp
          && request.resource.data
              .privacyAcceptedAt
              is timestamp;
    }

    match /users/{uid} {
      allow get:
        if isSelf(uid);

      allow list:
        if false;

      allow create:
        if isSelf(uid)
        && request.resource.data.uid
            == uid
        && request.resource.data
            .subscriptionPlan
            == 'free'
        && request.resource.data
            .onboardingCompleted
            == false
        && request.resource.data
            .createdAt
            is timestamp
        && hasCurrentLegalConsent();

      allow update:
        if isSelf(uid)
        && request.resource.data.uid
            == resource.data.uid
        && request.resource.data
            .subscriptionPlan
            == resource.data
                .subscriptionPlan
        && request.resource.data
            .createdAt
            == resource.data
                .createdAt
        && hasCurrentLegalConsent();

      allow delete:
        if false;

      match /preferences/{document=**} {
        allow read, write:
          if isSelf(uid);
      }

      match /activity/{document=**} {
        allow read:
          if isSelf(uid);

        allow write:
          if false;
      }
    }

    match /resumes/{resumeId} {
      allow read:
        if ownsExistingDocument();

      allow create:
        if ownsIncomingDocument()
        && request.resource.data.id
            == resumeId;

      allow update:
        if ownsExistingDocument()
        && ownsIncomingDocument()
        && request.resource.data.id
            == resource.data.id
        && request.resource.data.ownerId
            == resource.data.ownerId
        && request.resource.data.createdAt
            == resource.data.createdAt;

      allow delete:
        if ownsExistingDocument();
    }

    match /resume_versions/{versionId} {
      allow read:
        if ownsExistingDocument();

      allow create:
        if ownsIncomingDocument()
        && request.resource.data.id
            == versionId;

      allow update:
        if false;

      allow delete:
        if ownsExistingDocument();
    }

    match /ats_analyses/{analysisId} {
      allow read:
        if ownsExistingDocument();

      allow create, update:
        if false;

      allow delete:
        if ownsExistingDocument();
    }

    match /cover_letters/{letterId} {
      allow read:
        if ownsExistingDocument();

      allow create:
        if ownsIncomingDocument()
        && request.resource.data.id
            == letterId;

      allow update:
        if ownsExistingDocument()
        && ownsIncomingDocument()
        && request.resource.data.id
            == resource.data.id
        && request.resource.data.ownerId
            == resource.data.ownerId
        && request.resource.data.createdAt
            == resource.data.createdAt;

      allow delete:
        if ownsExistingDocument();
    }

    match /ai_generations/{generationId} {
      allow read:
        if ownsExistingDocument();

      allow write:
        if false;
    }

    match /subscriptions/{uid} {
      allow read:
        if isSelf(uid);

      allow write:
        if false;
    }

    match /{document=**} {
      allow read, write:
        if false;
    }
  }
}